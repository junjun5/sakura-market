# Template for local settings. Copy it to .env and change what you need:
#   cp .env.example .env
# .env is gitignored. Never commit real credentials; CI reads them from
# GitHub Actions secrets instead. Variables already set in the shell win over
# values in .env.

# Port the HTTP server listens on.
PORT=3000

# Lowest log level written: debug, info, warn, error or silent.
LOG_LEVEL=info

# Feature flag overrides as comma-separated name=on|off pairs; empty keeps every
# flag at its default. Flags and defaults are declared in src/flags.js.
# Example: FEATURE_FLAGS=metrics_endpoint=off
FEATURE_FLAGS=
